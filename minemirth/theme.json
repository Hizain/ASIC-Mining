{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1280px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "brand", "name": "Brand blue", "color": "var(--mm-primary, #35a8f6)" },
				{ "slug": "accent", "name": "Gradient partner", "color": "var(--mm-accent, #2563eb)" },
				{ "slug": "highlight", "name": "Highlight", "color": "var(--mm-accent-2, #5ee1ff)" },
				{ "slug": "text", "name": "Text (adapts to dark mode)", "color": "var(--mm-text, #0a1626)" },
				{ "slug": "muted", "name": "Muted text (adapts)", "color": "var(--mm-muted, #506279)" },
				{ "slug": "surface", "name": "Card surface (adapts)", "color": "var(--mm-surface, #ffffff)" },
				{ "slug": "background", "name": "Page background (adapts)", "color": "var(--mm-bg, #f4f8fc)" },
				{ "slug": "border", "name": "Border (adapts)", "color": "var(--mm-border, #d9e4ef)" },
				{ "slug": "navy", "name": "Deep navy", "color": "#050b14" },
				{ "slug": "white", "name": "White", "color": "#ffffff" },
				{ "slug": "success", "name": "Success", "color": "var(--mm-success, #12b981)" },
				{ "slug": "warning", "name": "Warning", "color": "var(--mm-warning, #f5a524)" },
				{ "slug": "danger", "name": "Danger", "color": "var(--mm-danger, #f04461)" }
			],
			"gradients": [
				{ "slug": "brand", "name": "Brand", "gradient": "linear-gradient(120deg, #5ee1ff 0%, #35a8f6 45%, #2563eb 100%)" },
				{ "slug": "night", "name": "Night", "gradient": "linear-gradient(160deg, #0a1b2f 0%, #040b15 100%)" },
				{ "slug": "glow", "name": "Glow", "gradient": "radial-gradient(80% 120% at 100% 0%, rgba(53,168,246,.35) 0%, rgba(53,168,246,0) 60%)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem" },
				{ "slug": "large", "name": "Large", "size": "1.375rem", "fluid": { "min": "1.2rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "2rem", "fluid": { "min": "1.6rem", "max": "2rem" } },
				{ "slug": "huge", "name": "Huge", "size": "3.25rem", "fluid": { "min": "2.4rem", "max": "3.25rem" } }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "em", "%", "vw", "vh" ]
		},
		"border": {
			"radius": true,
			"color": true,
			"width": true,
			"style": true
		}
	},
	"styles": {
		"blocks": {
			"core/button": {
				"border": { "radius": "var(--mm-btn-radius, 999px)" }
			}
		}
	}
}
